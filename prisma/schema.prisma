datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Usuario {
  id         String   @id @default(uuid())
  nome       String
  email      String   @unique
  senha_hash String
  role       String   @default("ANOTADOR") // "ADMIN" | "ANOTADOR"
  criado_em  DateTime @default(now())

  notas      Nota[]
  auditLogs  AuditLog[]
}

model Associada {
  id                   String   @id @default(uuid())
  nome                 String
  email                String?
  status_registro      String   @default("ATIVO") // ATIVO, INCOMPLETO, REVISAR, DUPLICADO
  
  // Atuação Docente
  leciona              Boolean  @default(false)
  vinculos_docentes    VinculoDocente[]
  
  // Atuação Profissional
  atuacao_profissional String?
  uf_atuacao           String?
  
  // Entidades
  ibdp                 Boolean  @default(false)
  abep                 Boolean  @default(false)
  
  // Lattes
  link_lattes          String?
  data_atualizacao_lattes String?
  
  // Titulação - Especialista
  especialista         Boolean  @default(false)
  
  // Titulação - Mestrado
  mestre               Boolean  @default(false)
  titulo_mestrado      String?
  ano_mestrado         String?
  faculdade_mestrado   String?
  area_mestrado        String?
  link_mestrado        String?
  
  // Titulação - Doutorado
  doutora              Boolean  @default(false)
  titulo_doutorado     String?
  ano_doutorado        String?
  faculdade_doutorado  String?
  area_doutorado       String?
  link_doutorado       String?
  
  // Titulação - Livre-Docência
  livre_docente             Boolean @default(false)
  titulo_livre_docencia     String?
  ano_livre_docencia        String?
  faculdade_livre_docencia  String?
  area_livre_docencia       String?
  link_livre_docencia       String?
  
  // Flexibilidade estrutural para novos campos
  dados_dinamicos      String   @default("{}") // JSON string for extra fields
  
  criado_em            DateTime @default(now())
  atualizado_em        DateTime @updatedAt

  notas                Nota[]
  producoes            ProducaoBibliografica[]
  registros_dinamicos  RegistroDinamico[]
}

model VinculoDocente {
  id                String   @id @default(uuid())
  associada_id      String
  associada         Associada @relation(fields: [associada_id], references: [id], onDelete: Cascade)
  tipo              String   // GRADUACAO or POS
  instituicao       String
  integra_ranking_40 Boolean @default(false)
  criado_em         DateTime @default(now())
}

model ProducaoBibliografica {
  id                   String   @id @default(uuid())
  associada_id         String
  associada            Associada @relation(fields: [associada_id], references: [id], onDelete: Cascade)
  
  tipo_obra            String   // Artigo, Livro, Capítulo de Livro, Anais de Eventos, Coluna em Jornais e Sites
  citacao_completa     String
  ano_publicacao       String
  area_processo        String   // P. Civil, P. Penal, P. Trabalhista, P. Tributário, P. Constitucional, Outros
  
  formato              String   // FISICA, ELETRONICA
  acesso_eletronica    String?  // PUBLICA, PROTEGIDA (se ELETRONICA)
  localizacao          String?  // Se FISICA ou ELETRONICA PROTEGIDA
  link_acesso          String?  // Se ELETRONICA PUBLICA
  
  dados_dinamicos      String   @default("{}")

  criado_em            DateTime @default(now())
}

model Nota {
  id           String    @id @default(uuid())
  texto        String
  criado_em    DateTime  @default(now())
  
  associada_id String
  associada    Associada @relation(fields: [associada_id], references: [id], onDelete: Cascade)
  
  autor_id     String
  autor        Usuario   @relation(fields: [autor_id], references: [id], onDelete: Restrict)
}

model AuditLog {
  id         String   @id @default(uuid())
  acao       String   // CREATE, UPDATE, DELETE
  entidade   String   // ex: Associada, ProducaoBibliografica, etc.
  entidadeId String?
  detalhes   String?  // JSON string
  criado_em  DateTime @default(now())

  usuario_id String
  usuario    Usuario  @relation(fields: [usuario_id], references: [id], onDelete: Restrict)
}

// Para tabelas customizadas (Novas Entidades)
model DefinicaoTabela {
  id         String   @id @default(uuid())
  nome       String
  descricao  String?
  schema     String   // JSON com definição de colunas [{"name": "Ano", "type": "string"}, ...]
  criado_em  DateTime @default(now())
  
  registros  RegistroDinamico[]
}

model RegistroDinamico {
  id           String    @id @default(uuid())
  tabela_id    String
  tabela       DefinicaoTabela @relation(fields: [tabela_id], references: [id], onDelete: Cascade)
  
  associada_id String?
  associada    Associada? @relation(fields: [associada_id], references: [id], onDelete: Cascade)
  
  dados        String    // JSON string com os valores
  criado_em    DateTime  @default(now())
  atualizado_em DateTime  @updatedAt
}

// Metadados para extensibilidade do sistema principal
model DefinicaoCampoExtra {
  id         String   @id @default(uuid())
  entidade   String   // 'Associada', 'ProducaoBibliografica'
  nome       String   // ex: 'Idade', 'Naturalidade'
  tipo       String   // 'string', 'number', 'boolean', 'date'
  obrigatorio Boolean @default(false)
  opcoes     String?  // JSON array for Select options
  criado_em  DateTime @default(now())
}
